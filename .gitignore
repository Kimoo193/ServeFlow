# .NET build output
bin/
obj/
*.user
*.suo

# Rider / VS / VS Code
.vs/
.vscode/
.idea/
*.DotSettings.user

# Test results
[Tt]est[Rr]esult*/
*.trx

# OS
.DS_Store
Thumbs.db

# Claude Code harness-local state (not project source)
.claude/

# Browser-automation screenshot/snapshot artifacts from local UI verification.
# Scoped to the tool's output dir, not a blanket *.png — this project may well
# ship real image assets one day.
.playwright-mcp/
/manager-connect.png

# Stray npm lockfile: backend/ is .NET and has no package.json. An empty
# lockfile lands here whenever someone runs npm in the wrong directory.
# Deliberately NOT a bare `package-lock.json` — frontend/package-lock.json is
# tracked and must stay that way.
/backend/package-lock.json

# Environment files — may contain secrets, connection strings, or API keys that
# must never be committed. Scoped to common naming conventions used by dotenv
# runtimes and orchestration tools.
.env
.env.*

# Private key material and TLS certificates. A .pfx found in the project tree
# is almost certainly a developer mistake; keys go in a vault or on the host
# filesystem outside the repo.
*.pfx
*.key

# Local-only config overrides saved by individual developers for their own
# machine (e.g. local Postgres port remapping). These are never tracked —
# the documented dev defaults live in appsettings.Development.json, which IS
# tracked and kept free of personal secrets.
appsettings.*.Local.json
